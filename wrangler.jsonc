{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluekite-biz",
  "account_id": "5871253814d74116cd773041aa530e40",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "dist", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/api/*"]},
  "routes": [{"pattern": "biz.bluekite.co.kr", "custom_domain": true}],
  "d1_databases": [{"binding": "DB", "database_name": "bluekite-biz", "database_id": "2a52102f-e796-4f88-a74b-9230b717c9db"}]
}
