{
  "name": "bluekite-business-world",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317",
    "api": "node server/local.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "start": "node scripts/start.mjs",
    "design:sync": "node scripts/sync-design-system.mjs",
    "design:check": "node scripts/sync-design-system.mjs --check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "@playwright/test": "^1.58.2",
    "wrangler": "^4.126.0"
  }
}
